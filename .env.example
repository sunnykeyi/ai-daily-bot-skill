# ============================================
# AI Daily Bot 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# 企业微信机器人 Webhook URL（必填）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# 本地 HTTP 服务端口（可选，默认 3456）
PORT=3456

# 日报风格: rationalist | modernism（可选，默认 rationalist）
DAILY_STYLE=rationalist

# 输出目录（可选，默认 ./output）
OUTPUT_DIR=./output

# 公开文件托管目录（可选，默认 ./public）
PUBLIC_DIR=./public

# AI-Daily 脚本目录（可选，默认 ./ai-daily）
AI_DAILY_DIR=./ai-daily

# X.com 凭证文件路径（可选，用于抓取 X 内容）
X_CREDS_PATH=~/.claude/private/x-creds.json
