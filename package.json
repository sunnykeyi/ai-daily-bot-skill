{
  "name": "ai-daily-bot",
  "version": "1.0.0",
  "description": "AI Daily 自动化日报工作流：信息采集 → HTML 生成 → 网页截图 → 企业微信推送",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
